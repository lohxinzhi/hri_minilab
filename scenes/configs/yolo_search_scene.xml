<mujoco model="yolo_search_scene">
  <compiler angle="radian" meshdir="../assets/objects" />

  <asset>
    <mesh name="chair" file="chair.obj" smoothnormal="true" />
    <mesh name="football" file="football.obj" smoothnormal="true" />
    <texture name="football_diffuse_texture" type="2d"
             file="../assets/objects/football_diffuse.png" />
    <material name="chair_green" rgba="0.02 0.82 0.04 1" specular="0.12" shininess="0.25" />
    <material name="chair_red" rgba="0.92 0.025 0.02 1" specular="0.12" shininess="0.25" />
    <material name="football_natural" texture="football_diffuse_texture"
              rgba="1 1 1 1" specular="0.1" shininess="0.2" />
  </asset>

  <worldbody>
    <geom name="scene_floor" type="plane" pos="0 0 0" size="20 20 0.1"
          rgba="0.66 0.68 0.70 1" friction="0.8 0.3 0.1" />

    <body name="chair_green_01" pos="2.5 1.2 0" euler="0 0 1.57079632679">
      <geom name="chair_green_visual" type="mesh" mesh="chair" material="chair_green"
            contype="0" conaffinity="0" />
      <geom name="chair_green_seat_collision" type="box" pos="0 0 0.43"
            size="0.27 0.27 0.035" rgba="0 0 0 0" />
      <geom name="chair_green_back_collision" type="box" pos="0 0.25 0.65"
            size="0.27 0.035 0.22" rgba="0 0 0 0" />
    </body>

    <body name="chair_red_01" pos="3.5 -1.2 0" euler="0 0 1.57079632679">
      <geom name="chair_red_visual" type="mesh" mesh="chair" material="chair_red"
            contype="0" conaffinity="0" />
      <geom name="chair_red_seat_collision" type="box" pos="0 0 0.43"
            size="0.27 0.27 0.035" rgba="0 0 0 0" />
      <geom name="chair_red_back_collision" type="box" pos="0 0.25 0.65"
            size="0.27 0.035 0.22" rgba="0 0 0 0" />
    </body>

    <body name="ball_01" pos="4.0 0.1 0">
      <geom name="ball_visual" type="mesh" mesh="football" material="football_natural"
            contype="0" conaffinity="0" />
      <geom name="ball_collision" type="sphere" pos="0 0 0.25"
            size="0.25" rgba="0 0 0 0" />
    </body>
  </worldbody>
</mujoco>
